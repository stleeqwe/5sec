{
  "rules": {
    ".read": false,
    ".write": false,

    "matching_queue": {
      ".indexOn": ["bucket", "timestamp", "status", "gender", "preferredGender", "randomSeed"],
      "$userId": {
        ".indexOn": ["status", "matchId", "timestamp", "bucket"],
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $userId"
      }
    },

    "matching_locks": {
      "$lockKey": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "matches": {
      ".indexOn": ["status", "timestamp", "user1", "user2"],
      "$matchId": {
        ".indexOn": ["timeRemaining", "status"],
        ".read": "auth != null && (data.child('user1').val() == auth.uid || data.child('user2').val() == auth.uid)",
        ".write": "auth != null && (data.child('user1').val() == auth.uid || data.child('user2').val() == auth.uid || !data.exists())",
        "endedBy": {
          "$oderId": {
            ".write": "auth != null && (root.child('matches').child($matchId).child('user1').val() == auth.uid || root.child('matches').child($matchId).child('user2').val() == auth.uid)"
          }
        }
      }
    },

    "presence": {
      ".indexOn": ["online", "lastSeen"],
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $userId"
      }
    },

    "notifications": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null",
        "newHeart": {
          "$notificationId": {
            ".validate": "newData.hasChildren(['timestamp', 'from'])"
          }
        },
        "suspension": {
          "$notificationId": {
            ".validate": "newData.hasChildren(['type', 'title', 'message', 'timestamp', 'isRead'])"
          }
        }
      }
    }
  }
}